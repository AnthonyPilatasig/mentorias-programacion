      "name": "2. Reservas (público)",
      "item": [
        {
          "name": "Crear reserva",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/reservas",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mentoriaId\": 3,\n  \"nombre\": \"María José Andrade\",\n  \"correo\": \"maria.andrade@correo.com\",\n  \"nivel\": \"intermedio\",\n  \"mensaje\": \"Quiero entender herencia e interfaces\",\n  \"inicio\": \"{{inicio}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 con Location y ETag', () => {",
                  "  pm.response.to.have.status(201);",
                  "  pm.expect(pm.response.headers.get('Location')).to.match(/^\\/api\\/reservas\\/\\d+$/);",
                  "  pm.expect(pm.response.headers.get('ETag')).to.eql('\"1\"');",
                  "});",
                  "const r = pm.response.json();",
                  "pm.test('Estado pendiente y fin = inicio + 90 min', () => {",
                  "  pm.expect(r.estado).to.eql('pendiente');",
                  "  pm.expect(new Date(r.fin) - new Date(r.inicio)).to.eql(90 * 60e3);",
                  "});",
                  "pm.collectionVariables.set('reservaId', r.id);",
                  "pm.collectionVariables.set('etag', pm.response.headers.get('ETag'));"
                ]
              }
            }
          ]
        },
