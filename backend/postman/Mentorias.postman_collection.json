                  "  pm.expect(p).to.have.property('traceId');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Horarios de un día",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/horarios?fecha={{fecha}}&mentoriaId=3"
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Elige al azar un día hábil entre 5 y 50 días adelante para que la colección sea repetible.",
                  "let d;",
                  "do {",
                  "  d = new Date(Date.now() - 5 * 3600e3 + (5 + Math.floor(Math.random() * 45)) * 864e5);",
                  "} while (d.getUTCDay() === 0);",
                  "pm.collectionVariables.set('fecha', d.toISOString().slice(0, 10));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 con horarios en hora de Ecuador', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().zonaHoraria).to.eql('America/Guayaquil');",
                  "});",
                  "const h = pm.response.json().horarios;",
                  "// Primer horario libre que tenga otro libre una hora después (para probar el solapamiento).",
                  "const i = h.findIndex((x, k) => x.disponible && h[k + 2] && h[k + 2].disponible);",
                  "pm.test('Hay un horario libre', () => pm.expect(i).to.be.at.least(0));",
                  "pm.collectionVariables.set('inicio', h[i].inicio);",
                  "pm.collectionVariables.set('inicioSolapado', h[i + 2].inicio);"
                ]
              }
            }
          ]
        },
        {
          "name": "Horarios sin parámetros",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/horarios"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('400 con ProblemDetails (validacion)', () => {",
                  "  pm.response.to.have.status(400);",
                  "  pm.expect(pm.response.headers.get('Content-Type')).to.include('application/problem+json');",
                  "  const p = pm.response.json();",
                  "  pm.expect(p.status).to.eql(400);",
                  "  pm.expect(p.codigo).to.eql('validacion');",
                  "  pm.expect(p).to.have.property('traceId');",
                  "});",
                  "pm.test('Indica los campos faltantes', () => {",
                  "  pm.expect(pm.response.json().errors).to.have.all.keys('fecha', 'mentoriaId');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
